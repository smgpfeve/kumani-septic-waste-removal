# .gitignore for Kumani project
node_modules/
*.log
*.tmp
*.swp
*.ckpt

# Netlify
.netlify/
.netlify.toml

# Cookies and temp files
.cookies.json
*.tmp

# Images and assets (keep them tracked)
# (no exclusion needed for source images)

# Node modules (if any dependencies)
node_modules/

# Jupyter / ipynb_checkpoints
.ipynb_checkpoints

# IDE / editor config
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Generated by Node.js
npm-debug.log
npm-debug.log.*


# Exclude all generated content that doesn't need to be versioned
*.log
*.tmp
*.bak
*.tmp
*.tmp1
*.tmp1db
*.bak

# Exclude all logs
*.log

# Exclude all environment files
.env
.env.local
.env.development
.env.test

# Exclude backup files
*~
*%


# Ignore style files and cache
*.css.swp
*~


# Exclude any checkpoint files
*%


# Git notes: avoid committing temporary files, swap files, etc.